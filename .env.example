# Docker Compose reads .env automatically. Node itself does not: use the command documented below.
# Keep this example free of real credentials.
HOST=127.0.0.1
PORT=3000
MYBOOKS_PORT=3000
NODE_ENV=production
MYBOOKS_STORAGE_DIR=./storage
MYBOOKS_PUBLIC_URL=http://localhost:3000
MYBOOKS_PUBLIC_READ=false
MYBOOKS_SEED_DEMO=false
# Enable only for a trusted local reverse proxy:
# MYBOOKS_TRUST_PROXY=loopback
# Create the administrator with npm run setup; do not store its password here.

# Toolbox / Python plugin runtime (optional; Compose supplies most of these).
# MYBOOKS_TOOLBOX_DIR=/toolbox
# MYBOOKS_TOOLBOX_RUNTIME_URL=http://toolbox-runtime:8765
# Shared secrets are auto-generated under ${MYBOOKS_TOOLBOX_DIR}/state/.
# MYBOOKS_TOOLBOX_RUNTIME_SECRET=
# MYBOOKS_TOOLBOX_INTERNAL_SECRET=
# MYBOOKS_TOOLBOX_DATA_KEY=
# Default false. Only enable after reviewing every plugin you intend to run.
# MYBOOKS_TOOLBOX_ALLOW_UNREVIEWED=false
# Allow the trusted store host to resolve to a private/VPN address.
# MYBOOKS_TOOLBOX_ALLOW_PRIVATE_STORE=false
# audiobook_srt scans this directory for audio files.
# MYBOOKS_AUDIO_DIR=/toolbox/data/audio
